// ~/.openclaw/openclaw.json5
// Шаблон: «бесплатный мозг 24/7 + hardened gateway».
// Заменяй <...> своими значениями. Точные id провайдеров/моделей проверяй командой:
//     openclaw models list
// Перед применением: openclaw doctor --fix && openclaw gateway restart
{
  gateway: {
    mode: "local",
    port: 18789,
    // Никогда не "lan"/"all" на машине с личными файлами. Удалённый доступ — через
    // SSH-туннель или Tailscale Serve, при этом bind остаётся loopback.
    bind: "loopback",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}", // openclaw doctor --generate-gateway-token
      rateLimit: { maxAttempts: 10, windowMs: 60000, lockoutMs: 300000, exemptLoopback: true },
    },
  },

  // Один контекст на пару «канал + собеседник» — чтобы группы не смешивались с личкой.
  session: { dmScope: "per-channel-peer" },

  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",

      // Цепочка: сначала бесплатный облачный, потом второй бесплатный, потом локальный.
      // Формат ссылки всегда "<provider-id>/<model-id>".
      model: {
        primary: "gemini/gemini-2.5-flash",                        // GEMINI_API_KEY
        fallback: [
          "groq/llama-3.3-70b-versatile",                          // GROQ_API_KEY
          "openrouter/deepseek/deepseek-chat-v3.1:free",           // OPENROUTER_API_KEY
          "ollama/qwen3:32b",                                      // локально, без ключа
        ],
      },
    },
  },

  models: {
    mode: "merge",
    providers: {
      // --- Локальная модель -------------------------------------------------
      // ВАЖНО: без "/v1" в baseUrl. С /v1 включается OpenAI-compat режим, и
      // tool-calling начинает «печататься текстом» вместо вызова инструментов.
      ollama: {
        api: "ollama",
        baseUrl: "http://127.0.0.1:11434", // no /v1 !
        apiKey: "ollama-local",
        timeoutSeconds: 300,               // холодная загрузка модели в RAM
        models: [{ id: "qwen3:32b", name: "Qwen3 32B (local)" }],
      },

      // --- Свой шлюз/прокси (LiteLLM, vLLM, SGLang, MLX, Ollama-proxy) ------
      // Любой сервер с OpenAI-совместимым /v1/chat/completions.
      // Сюда же можно однажды подставить любой «умный» бэкенд, который у тебя появится.
      "my-gateway": {
        api: "openai-completions",
        baseUrl: "https://my-litellm.example/v1",
        apiKey: "${LITELLM_KEY}",
        models: [
          {
            id: "smart",
            name: "Smart (LiteLLM router)",
            reasoning: false,
            input: ["text"],
            contextWindow: 200000,
            maxTokens: 8192,
            // Стоимость в USD за 1K токенов — только для статистики, не для списаний.
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
          },
        ],
      },

      // --- Приватный сервер без аутентификации (tailnet/VPN) ----------------
      // auth: "none" -> OpenClaw не отправляет Authorization вообще.
      "my-studio": {
        api: "openai-completions",
        baseUrl: "https://studio.example.ts.net/v1",
        auth: "none",
        models: [{ id: "qwen3.8", name: "Qwen3.8 (tailnet)" }],
      },
    },
  },

  // --- Политика инструментов: минимум по умолчанию -------------------------
  tools: {
    profile: "messaging",                 // стартуем с минимального набора
    deny: [
      "group:automation",                 // cron и т.п. — включить осознанно позже
      "group:fs",                         // см. ниже: fs включаем только в workspace
      "group:runtime",
      "sessions_spawn",
      "sessions_send",
    ],
    fs: { workspaceOnly: true },          // агент не видит ~/.ssh, /etc, чужие папки
    exec: {
      security: "deny",                   // "deny" блокирует ВЕСЬ exec, включая диагностику
      ask: "always",                      // если включаешь — только с подтверждением
    },
    elevated: { enabled: false },
    agentToAgent: { enabled: false },
  },

  channels: {
    telegram: {
      enabled: true,
      botToken: "${TELEGRAM_BOT_TOKEN}",
      dmPolicy: "pairing",                // незнакомец получает код, а не ответ агента
      allowFrom: ["tg:<твой-id>"],        // узнаётся из первого pairing-сообщения
      groupPolicy: "allowlist",
      groups: { "*": { requireMention: true } },
    },
  },
}
